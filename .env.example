# Copy to server/.env (local) or set in your host's dashboard. Never commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safar
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/safar_test
# Set DATABASE_SSL=true for hosted Postgres such as Neon
DATABASE_SSL=false
# At least 16 characters. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
# Comma-separated origins allowed to call the API with cookies (dev: the Vite server)
CORS_ORIGIN=http://localhost:5173
# Business rules
HOLD_TTL_SECONDS=600
BOOKING_CUTOFF_MINUTES=30
MAX_SEATS_PER_BOOKING=6
LOG_LEVEL=info
